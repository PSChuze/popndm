# pop'n server settings. Copy to .env, or run pop'n Server Setup (python setup.py),
# which writes it. After a change: docker compose up -d

# The IP address the gate hands players in its server list. The game takes an IP
# address here, not a name. Your LAN address when everyone plays at home; your
# internet address when friends play over the internet.
POPN_ADVERTISE=192.0.2.10

# Different addresses for different player networks, first match wins:
#   cidr=ip,cidr=ip,...
# For example LAN players get the LAN address and everyone else the internet one:
#   192.168.0.0/16=192.0.2.10,0.0.0.0/0=203.0.113.5
# Leave it empty on Docker Desktop: there every player seems to come from one
# private address, so only POPN_ADVERTISE counts.
POPN_ADVERTISE_MAP=

# Battle relay: consoles installed with the relay patch connect out to the server
# for a match, so no player needs an open port. 0 only for unpatched installs, which battle console to
# console and need tcp/5730 open on one side.
POPN_P2P_RELAY=1
# The address handed out for the relay; empty means the same as the server list.
POPN_RELAY_HOST=

# 1: a login with an id the server does not know is let in (it becomes an account).
# Ids issued by the game's own New Account screen always work, and an id with a
# stored password must match it.
POPN_AUTH_OPEN=1

# Seconds without a heartbeat before a lobby connection is dropped.
POPN_IDLE_TIMEOUT=120

# How often (seconds) data/board/live.json is written for status pages; 0 = off.
POPN_LIVE_EVERY=10

# The admin port token for an OpenLobby admin panel (header X-Devtool-Token).
# Empty keeps the admin port off. Setup makes one: 32 or more random characters.
POPN_ADMIN_TOKEN=
# The pairing secret an OpenLobby panel returns when setup pairs with it.
OPENLOBBY_PAIRING=

# Test helpers, off for real play:
#   POPN_FAKE_CHAR=1   give an account with no character one called POPN1
#   POPN_SEED_ROOM=1   keep one open room (POPN_SEED_NAME) for testing joins
POPN_FAKE_CHAR=
POPN_SEED_ROOM=
#POPN_SEED_NAME=TEST

# Where things are kept on this machine (relative to this folder).
#POPN_STATE=./state
